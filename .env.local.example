# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Get from: https://dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Create in: Stripe Dashboard → Products → Add product → Add price
STRIPE_BASIC_MONTHLY_PRICE_ID=price_...
STRIPE_BASIC_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_AGENCY_MONTHLY_PRICE_ID=price_...
STRIPE_AGENCY_ANNUAL_PRICE_ID=price_...

# ─── PayPal ───────────────────────────────────────────────────────────────────
# Get from: https://developer.paypal.com → Apps & Credentials
# Sandbox: https://api-m.sandbox.paypal.com  |  Live: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Get from: PayPal dashboard → your app → Webhooks tab
PAYPAL_WEBHOOK_ID=your-webhook-id
# Create in: PayPal dashboard → Subscriptions → Products → Plans
PAYPAL_BASIC_MONTHLY_PLAN_ID=P-...
PAYPAL_BASIC_ANNUAL_PLAN_ID=P-...
PAYPAL_PRO_MONTHLY_PLAN_ID=P-...
PAYPAL_PRO_ANNUAL_PLAN_ID=P-...
PAYPAL_AGENCY_MONTHLY_PLAN_ID=P-...
PAYPAL_AGENCY_ANNUAL_PLAN_ID=P-...

# ─── Resend ──────────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified domain in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=invoices@yourdomain.com
RESEND_FROM_NAME=BillCraft AI

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Custom email sending (org-connected Google/Microsoft mailboxes) ─────────
# Encrypts OAuth client secrets/refresh tokens. Generate: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-base64-key

# ─── Cron ────────────────────────────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
# Add to Vercel: Settings → Environment Variables
CRON_SECRET=your-random-secret
