# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=yourdomain.com,localhost:3000

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Google OAuth (Sign in with Google) ────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Default flow is "custom" (uses these vars). Set GOOGLE_AUTH_FLOW=supabase to
# use Supabase's built-in provider instead (requires a custom domain on Supabase Pro).
GOOGLE_AUTH_FLOW=custom
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=invoices@yourdomain.com
RESEND_FROM_NAME=

# ─── Outbound mail provider (invoices/estimates/reminders) ────────────────────
# EMAIL_PROVIDER selects resend (default) or gmail. When gmail, GMAIL_* must
# all be set or mailer.ts falls back to resend.
EMAIL_PROVIDER=resend
EMAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ─── Stripe (payments + subscriptions) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_MONTHLY_PRICE_ID=price_...
STRIPE_BASIC_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_AGENCY_MONTHLY_PRICE_ID=price_...
STRIPE_AGENCY_ANNUAL_PRICE_ID=price_...

# ─── PayPal (alternative subscription billing) ────────────────────────────────
# Leave blank to disable PayPal billing
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_BASIC_MONTHLY_PLAN_ID=
PAYPAL_BASIC_ANNUAL_PLAN_ID=
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_ANNUAL_PLAN_ID=
PAYPAL_AGENCY_MONTHLY_PLAN_ID=
PAYPAL_AGENCY_ANNUAL_PLAN_ID=

# ─── Custom email sending (org-connected Google/Microsoft mailboxes) ──────────
# 32-byte key, base64-encoded, encrypts OAuth client secrets/refresh tokens.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Client portal ────────────────────────────────────────────────────────────
# Random 32-character secret for HMAC-SHA256 portal session cookies.
# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
# Set in Vercel dashboard; used to authenticate cron job requests.
CRON_SECRET=

# ─── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=
